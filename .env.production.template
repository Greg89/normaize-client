# Client Production Environment Variables Template
# Copy this file to .env.production and update with your actual values

# =============================================================================
# APP CONFIGURATION
# =============================================================================
VITE_APP_NAME=Normaize
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Data Normalization Platform
VITE_NODE_ENV=production

# =============================================================================
# AUTH0 CONFIGURATION
# =============================================================================

# Auth0 Settings (Required for authentication)
# These must match your Auth0 tenant and application configuration
VITE_AUTH0_DOMAIN=your-production-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=normaize-api

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API Base URL (Your deployed API server)
VITE_API_URL=https://your-api-domain.com
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Seq Logging (Optional - for structured logging)
# VITE_SEQ_URL=https://your-seq-instance.com
# VITE_SEQ_API_KEY=your-seq-api-key
VITE_LOG_LEVEL=warn

# =============================================================================
# ERROR TRACKING
# =============================================================================

# Sentry Configuration (Optional - for error tracking)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# VITE_SENTRY_ENVIRONMENT=production

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Production Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_DEBUG_TOOLS=false

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================

# Production Build Settings
VITE_SOURCE_MAP=false
VITE_MINIFY=true
VITE_TARGET_BROWSERS=defaults

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Railway-specific (if using Railway)
# These are automatically provided by Railway:
# PORT - The port your app should listen on
# RAILWAY_ENVIRONMENT - The environment name
# RAILWAY_PROJECT_ID - Your project ID
# RAILWAY_SERVICE_ID - Your service ID

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Content Security Policy Origins (if needed)
# VITE_CSP_CONNECT_SRC=https://your-api-domain.com https://your-auth0-domain.auth0.com

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# CDN Configuration (if using a CDN)
# VITE_CDN_URL=https://your-cdn-domain.com
# VITE_ASSET_URL=https://your-cdn-domain.com/assets

# =============================================================================
# ANALYTICS CONFIGURATION (Optional)
# =============================================================================

# Google Analytics
# VITE_GA_TRACKING_ID=GA-XXXXX-X

# Mixpanel
# VITE_MIXPANEL_TOKEN=your-mixpanel-token

# =============================================================================
# THIRD-PARTY SERVICES (Optional)
# =============================================================================

# Support/Chat Widget
# VITE_INTERCOM_APP_ID=your-intercom-app-id
# VITE_ZENDESK_KEY=your-zendesk-key